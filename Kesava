<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TaskFlow Pro | Task Manager</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f6fc;
    color: #242640;
}

header {
    background: linear-gradient(135deg, #6558e8, #8875f4);
    color: white;
    padding: 25px;
    text-align: center;
}

header h1 {
    font-size: 30px;
    margin-bottom: 8px;
}

header p {
    opacity: 0.9;
}

.container {
    max-width: 1000px;
    margin: 30px auto;
    padding: 20px;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-bottom: 25px;
}

.stat-card {
    background: white;
    padding: 22px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #00000008;
    text-align: center;
}

.stat-card h3 {
    color: #777b91;
    font-size: 14px;
    margin-bottom: 12px;
}

.stat-card p {
    font-size: 28px;
    font-weight: bold;
    color: #6b5ce7;
}

.panel {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #00000008;
    margin-bottom: 25px;
}

.panel h2 {
    margin-bottom: 20px;
}

.form-group {
    margin-bottom: 16px;
}

label {
    display: block;
    margin-bottom: 7px;
    font-size: 14px;
    font-weight: bold;
}

input, textarea, select {
    width: 100%;
    padding: 12px;
    border: 1px solid #dfe2ed;
    border-radius: 7px;
    font-size: 14px;
    outline: none;
    font-family: inherit;
}

input:focus, textarea:focus, select:focus {
    border-color: #6b5ce7;
}

textarea {
    resize: vertical;
    min-height: 75px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

button {
    border: none;
    padding: 11px 16px;
    border-radius: 7px;
    cursor: pointer;
    font-weight: bold;
    font-size: 13px;
    transition: 0.2s;
}

button:hover {
    opacity: 0.85;
    transform: translateY(-1px);
}

.primary-btn {
    background: #6b5ce7;
    color: white;
}

.secondary-btn {
    background: #eceaff;
    color: #6558d9;
}

.delete-btn {
    background: #ffe8e8;
    color: #d94343;
}

.complete-btn {
    background: #e3f8eb;
    color: #218b50;
}

.toolbar {
    display: flex;
    gap: 10px;
    margin-bottom: 18px;
}

.toolbar input {
    flex: 1;
    min-width: 0;
}

.toolbar select {
    max-width: 180px;
}

.task {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 17px 0;
    border-bottom: 1px solid #eceef5;
}

.task:last-child {
    border-bottom: none;
}

.task-info {
    flex: 1;
    min-width: 0;
}

.task-info h3 {
    font-size: 16px;
    margin-bottom: 7px;
    overflow-wrap: anywhere;
}

.task-info p {
    font-size: 13px;
    color: #85899d;
    margin-bottom: 10px;
    overflow-wrap: anywhere;
}

.task.completed .task-info h3 {
    text-decoration: line-through;
    color: #999;
}

.task.completed .task-info p {
    color: #aaa;
}

.badge {
    display: inline-block;
    padding: 5px 8px;
    margin: 3px 5px 3px 0;
    border-radius: 5px;
    font-size: 11px;
    font-weight: bold;
}

.high {
    background: #ffe6e6;
    color: #d33e4b;
}

.medium {
    background: #fff2d9;
    color: #b57a15;
}

.low {
    background: #e2f8ea;
    color: #26814a;
}

.category {
    background: #eeeaff;
    color: #6558d9;
}

.task-date {
    font-size: 11px;
    color: #8c90a2;
    display: inline-block;
    margin-top: 8px;
}

.task-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.task-actions button {
    padding: 8px 10px;
}

.empty {
    text-align: center;
    color: #9397aa;
    padding: 30px 10px;
}

footer {
    text-align: center;
    padding: 20px;
    color: #9296a9;
    font-size: 12px;
}

@media (max-width: 650px) {
    .container {
        margin: 15px auto;
        padding: 12px;
    }

    .stats {
        gap: 8px;
    }

    .stat-card {
        padding: 15px 5px;
    }

    .stat-card h3 {
        font-size: 11px;
    }

    .stat-card p {
        font-size: 23px;
    }

    .panel {
        padding: 16px;
    }

    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .task {
        flex-wrap: wrap;
    }

    .task-info {
        flex-basis: 75%;
    }

    .task-actions {
        width: 100%;
        padding-left: 30px;
    }

    .toolbar {
        flex-wrap: wrap;
    }

    .toolbar input {
        flex-basis: 100%;
    }

    .toolbar select {
        max-width: none;
    }
}
</style>
</head>

<body>

<header>
    <h1>TaskFlow Pro</h1>
    <p>Organize your work. Focus on what matters.</p>
</header>

<main class="container">

    <section class="stats">
        <div class="stat-card">
            <h3>Total Tasks</h3>
            <p id="totalTasks">0</p>
        </div>

        <div class="stat-card">
            <h3>In Progress</h3>
            <p id="pendingTasks">0</p>
        </div>

        <div class="stat-card">
            <h3>Completed</h3>
            <p id="completedTasks">0</p>
        </div>
    </section>

    <section class="panel">
        <h2 id="formTitle">Create New Task</h2>

        <form id="taskForm" novalidate>
            <div class="form-group">
                <label for="title">Task Title *</label>
                <input
                    type="text"
                    id="title"
                    maxlength="100"
                    placeholder="Enter task title"
                    required
                >
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea
                    id="description"
                    maxlength="240"
                    placeholder="Enter task description"
                ></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="category">Category</label>
                    <select id="category">
                        <option>Study</option>
                        <option>Work</option>
                        <option>Personal</option>
                        <option>Health</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="priority">Priority</label>
                    <select id="priority">
                        <option>Low</option>
                        <option selected>Medium</option>
                        <option>High</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label for="dueDate">Due Date *</label>
                <input type="date" id="dueDate" required>
            </div>

            <button type="submit" class="primary-btn" id="submitBtn">
                + Add Task
            </button>

            <button
                type="button"
                class="secondary-btn"
                id="cancelEdit"
                hidden
                onclick="resetForm()"
            >
                Cancel Edit
            </button>
        </form>
    </section>

    <section class="panel">
        <h2>My Tasks</h2>

        <div class="toolbar">
            <input
                type="search"
                id="search"
                placeholder="Search tasks..."
                aria-label="Search tasks"
            >

            <select id="filter" aria-label="Filter tasks">
                <option value="all">All Tasks</option>
                <option value="pending">In Progress</option>
                <option value="completed">Completed</option>
                <option value="today">Due Today</option>
            </select>

            <select id="sort" aria-label="Sort tasks">
                <option value="date">Sort by Date</option>
                <option value="priority">Sort by Priority</option>
                <option value="newest">Recently Added</option>
            </select>
        </div>

        <div id="taskList"></div>
    </section>

</main>

<footer>
    TaskFlow Pro © 2026 | Manage your day, one task at a time.
</footer>

<script>
"use strict";

/* ---------- STATE MANAGEMENT ---------- */

const STORAGE_KEY = "taskflow-pro-tasks";

function loadTasks() {
    try {
        const saved = localStorage.getItem(STORAGE_KEY);
        const parsed = saved ? JSON.parse(saved) : [];
        return Array.isArray(parsed) ? parsed : [];
    } catch (error) {
        console.error("Unable to load saved tasks:", error);
        return [];
    }
}

let tasks = loadTasks();
let editingId = null;

function saveTasks() {
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks));
    } catch (error) {
        alert("Unable to save tasks. Please check your browser storage.");
    }
}

/* ---------- REUSABLE COMPONENTS ---------- */

function createElement(tag, className, text) {
    const element = document.createElement(tag);

    if (className) {
        element.className = className;
    }

    if (text !== undefined) {
        element.textContent = text;
    }

    return element;
}

function createButton(text, className, action) {
    const button = createElement("button", className, text);
    button.type = "button";
    button.addEventListener("click", action);
    return button;
}

function getToday() {
    const date = new Date();
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");

    return `${year}-${month}-${day}`;
}

/* ---------- FORM VALIDATION ---------- */

const taskForm = document.getElementById("taskForm");
const titleInput = document.getElementById("title");
const descriptionInput = document.getElementById("description");
const categoryInput = document.getElementById("category");
const priorityInput = document.getElementById("priority");
const dueDateInput = document.getElementById("dueDate");

taskForm.addEventListener("submit", function(event) {
    event.preventDefault();

    const title = titleInput.value.trim();
    const description = descriptionInput.value.trim();
    const category = categoryInput.value;
    const priority = priorityInput.value;
    const dueDate = dueDateInput.value;

    if (title.length < 3) {
        alert("Task title must contain at least 3 characters.");
        titleInput.focus();
        return;
    }

    if (title.length > 100) {
        alert("Task title cannot exceed 100 characters.");
        titleInput.focus();
        return;
    }

    if (description.length > 240) {
        alert("Description cannot exceed 240 characters.");
        descriptionInput.focus();
        return;
    }

    if (!dueDate) {
        alert("Please select a due date.");
        dueDateInput.focus();
        return;
    }

    const taskData = {
        title,
        description,
        category,
        priority,
        dueDate
    };

    if (editingId !== null) {
        tasks = tasks.map(function(task) {
            return task.id === editingId
                ? { ...task, ...taskData }
                : task;
        });
    } else {
        tasks.unshift({
            id: Date.now(),
            ...taskData,
            completed: false,
            createdAt: Date.now()
        });
    }

    saveTasks();
    resetForm();
    renderTasks();
});

/* ---------- CREATE / EDIT TASK ---------- */

function editTask(id) {
    const task = tasks.find(function(item) {
        return item.id === id;
    });

    if (!task) return;

    editingId = id;

    titleInput.value = task.title;
    descriptionInput.value = task.description;
    categoryInput.value = task.category;
    priorityInput.value = task.priority;
    dueDateInput.value = task.dueDate;

    document.getElementById("formTitle").textContent = "Edit Task";
    document.getElementById("submitBtn").textContent = "Save Changes";
    document.getElementById("cancelEdit").hidden = false;

    document.querySelector(".panel").scrollIntoView({
        behavior: "smooth",
        block: "start"
    });

    titleInput.focus();
}

function resetForm() {
    taskForm.reset();
    editingId = null;

    document.getElementById("formTitle").textContent = "Create New Task";
    document.getElementById("submitBtn").textContent = "+ Add Task";
    document.getElementById("cancelEdit").hidden = true;
}

/* ---------- COMPLETE / DELETE TASK ---------- */

function toggleTask(id) {
    tasks = tasks.map(function(task) {
        return task.id === id
            ? { ...task, completed: !task.completed }
            : task;
    });

    saveTasks();
    renderTasks();
}

function deleteTask(id) {
    const confirmed = confirm("Are you sure you want to delete this task?");

    if (!confirmed) return;

    tasks = tasks.filter(function(task) {
        return task.id !== id;
    });

    if (editingId === id) {
        resetForm();
    }

    saveTasks();
    renderTasks();
}

/* ---------- FILTERING AND SORTING ---------- */

function getVisibleTasks() {
    const searchText = document.getElementById("search")
        .value.trim().toLowerCase();

    const filter = document.getElementById("filter").value;
    const sort = document.getElementById("sort").value;

    let visible = tasks.filter(function(task) {
        const matchesSearch =
            task.title.toLowerCase().includes(searchText) ||
            task.description.toLowerCase().includes(searchText) ||
            task.category.toLowerCase().includes(searchText);

        let matchesFilter = true;

        if (filter === "pending") {
            matchesFilter = !task.completed;
        } else if (filter === "completed") {
            matchesFilter = task.completed;
        } else if (filter === "today") {
            matchesFilter =
                task.dueDate === getToday() && !task.completed;
        }

        return matchesSearch && matchesFilter;
    });

    if (sort === "date") {
        visible.sort((a, b) => a.dueDate.localeCompare(b.dueDate));
    } else if (sort === "priority") {
        const priorityOrder = {
            High: 1,
            Medium: 2,
            Low: 3
        };

        visible.sort((a, b) =>
            priorityOrder[a.priority] - priorityOrder[b.priority]
        );
    } else if (sort === "newest") {
        visible.sort((a, b) => b.createdAt - a.createdAt);
    }

    return visible;
}

/* ---------- REUSABLE TASK CARD ---------- */

function createTaskCard(task) {
    const card = createElement(
        "article",
        task.completed ? "task completed" : "task"
    );

    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.checked = task.completed;
    checkbox.setAttribute(
        "aria-label",
        "Mark " + task.title + " as completed"
    );

    checkbox.addEventListener("change", function() {
        toggleTask(task.id);
    });

    card.appendChild(checkbox);

    const info = createElement("div", "task-info");
    info.appendChild(createElement("h3", "", task.title));

    if (task.description) {
        info.appendChild(
            createElement("p", "", task.description)
        );
    }

    const priorityClass = task.priority.toLowerCase();

    info.appendChild(
        createElement(
            "span",
            "badge " + priorityClass,
            task.priority + " Priority"
        )
    );

    info.appendChild(
        createElement("span", "badge category", task.category)
    );

    const dueDate = createElement(
        "span",
        "task-date",
        "Due: " + task.dueDate
    );

    if (!task.completed && task.dueDate < getToday()) {
        dueDate.textContent += " (Overdue)";
        dueDate.style.color = "#d94343";
    }

    info.appendChild(document.createElement("br"));
    info.appendChild(dueDate);
    card.appendChild(info);

    const actions = createElement("div", "task-actions");

    actions.appendChild(
        createButton(
            "Edit",
            "secondary-btn",
            function() {
                editTask(task.id);
            }
        )
    );

    actions.appendChild(
        createButton(
            "Delete",
            "delete-btn",
            function() {
                deleteTask(task.id);
            }
        )
    );

    card.appendChild(actions);

    return card;
}

/* ---------- DASHBOARD AND RENDERING ---------- */

function updateStats() {
    const total = tasks.length;
    const completed = tasks.filter(task => task.completed).length;

    document.getElementById("totalTasks").textContent = total;

    document.getElementById("pendingTasks").textContent =
        total - completed;

    document.getElementById("completedTasks").textContent =
        completed;
}

function renderTasks() {
    const list = document.getElementById("taskList");
    list.replaceChildren();

    const visibleTasks = getVisibleTasks();

    if (visibleTasks.length === 0) {
        list.appendChild(
            createElement(
                "div",
                "empty",
                tasks.length === 0
                    ? "No tasks yet. Add your first task above!"
                    : "No matching tasks found."
            )
        );
    } else {
        visibleTasks.forEach(function(task) {
            list.appendChild(createTaskCard(task));
        });
    }

    updateStats();
}

/* ---------- EVENT LISTENERS ---------- */

document.getElementById("search").addEventListener("input", renderTasks);
document.getElementById("filter").addEventListener("change", renderTasks);
document.getElementById("sort").addEventListener("change", renderTasks);

/* ---------- INITIALIZE APPLICATION ---------- */

renderTasks();
</script>

</body>
</html>